<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <Platforms>x86</Platforms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WglDxInterop</RootNamespace>
    <AssemblyName>WglDxInterop</AssemblyName>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
  </PropertyGroup>

  <!--
    Stage 1 (this csproj): managed build only. Runs as a normal x86 .NET app to keep
    iteration tight while we prove the WGL_NV_DX_interop2 chain. Stage 2 turns on
    PublishAot=true and TrimMode=link to mirror the engine's build flags so spike
    question A6 (NativeAOT survival) can be answered before engine integration.
  -->

</Project>
