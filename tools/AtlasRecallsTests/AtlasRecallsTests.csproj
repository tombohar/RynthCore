<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the recall spells as Atlas places (2026-10-22, Skippy: RynthNav's Atlas found
    nothing for "neft"): src\RynthCore.Engine\UI\Data\RynthNavAtlasRecalls.cs (NavPlace and
    RynthNavAtlasRecalls.Read), compiled in. A sample "recalls" array: on-map and dungeon spots, a
    spell listed twice, unnamed and malformed entries, no "recalls" at all. Then the shipped
    C:\Games\RynthCore\NavData\locations.json, read only, when it is there: its recalls load, and
    "neft" now finds a place. No ImGui, no game. Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>AtlasRecallsTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\UI\Data\RynthNavAtlasRecalls.cs" Link="Engine\RynthNavAtlasRecalls.cs" />
  </ItemGroup>

</Project>
