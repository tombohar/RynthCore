<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the Decal bridge's shared-memory protocol (src\RynthCore.DecalBridge\
    BridgeProtocol.cs, compiled in - the same file the engine and the bridge link): both
    rings, wrap-around, full rings, the want mask, the version check and resync after a
    corrupt record. Two channels on a made-up pid play the bridge and the engine.
    Nothing native: no AC, no Decal. See docs\DECAL_BRIDGE_PLAN.md.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>DecalBridgeProtocolTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.DecalBridge\BridgeProtocol.cs" Link="Bridge\BridgeProtocol.cs" />
  </ItemGroup>

</Project>
