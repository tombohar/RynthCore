<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the chat window's coordinate finder (src\RynthCore.Engine\UI\Data\
    ChatCoords.cs + a ChatSpan stand-in, compiled in): which chat lines hold map coordinates, in which order and
    format, and which ordinary lines must not turn into coordinates.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>ChatCoordTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\UI\Data\ChatCoords.cs" Link="Engine\ChatCoords.cs" />
  </ItemGroup>

</Project>
