<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the Items faces' "No buff" shield toggle: ItemsPanel.WeaponEntry must read
    RynthAi's "noBuff" (sent for every entry; null from an older RynthAi), show the toggle on shield
    entries only, and write the field back only when it holds a value. Reaches the internal types by
    reflection (the engine has no test seam). x86, like the engine: needs the x86 .NET runtime.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Platforms>x86</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>ItemsNoBuffTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RynthCore.Engine\RynthCore.Engine.csproj" />
  </ItemGroup>

</Project>
