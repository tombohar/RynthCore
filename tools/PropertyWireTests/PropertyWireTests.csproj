<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the engine's property parsers (src\RynthCore.Engine\Compatibility\
    PropertyWire.cs, compiled in): identify replies, PlayerDescription and every
    UpdateProperty* message, built byte for byte the way ACE writes them (AceWire.cs mirrors
    ACE.Server's writers), one per kind of object, plus the PublicWeenieDesc field map.
    Nothing native: no AC, no engine state.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>PropertyWireTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\Compatibility\PropertyWire.cs" Link="Engine\PropertyWire.cs" />
  </ItemGroup>

</Project>
