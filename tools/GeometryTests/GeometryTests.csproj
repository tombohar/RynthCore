<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Checks RynthCore.Geometry against the real dats (C:\Turbine\Asheron's Call, read-only) and
    against ground truth captured from the local ACE server (Vectors\: positions of creatures
    standing on terrain in five towns, and on dungeon floors in landblock 0x6146).
    Without the dats it prints SKIP and exits 0.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>GeometryTests</RootNamespace>
    <AssemblyName>GeometryTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Vectors\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RynthCore.Geometry\RynthCore.Geometry.csproj" />
  </ItemGroup>

</Project>
