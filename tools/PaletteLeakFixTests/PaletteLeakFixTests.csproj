<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the palette leak fix (src\RynthCore.Engine\Compatibility\PaletteLeakSites.cs and
    LauncherSettings.cs, compiled in): how each site's bytes are read (stock, already fixed, NOP'd,
    unknown) on fake bytes, and the launcher setting the engine reads (off unless FixPaletteLeak is true).
    No game client. Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>PaletteLeakFixTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\Compatibility\PaletteLeakSites.cs" Link="Engine\PaletteLeakSites.cs" />
    <Compile Include="..\..\src\RynthCore.Engine\Compatibility\LauncherSettings.cs" Link="Engine\LauncherSettings.cs" />
  </ItemGroup>

</Project>
