<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for closing the client on a server disconnect (2026-10-11):
    src\RynthCore.Engine\Compatibility\ServerDisconnectClosePolicy.cs, compiled in. On AC's
    Disconnected screen ("The server has disconnected", only Quit Game) the engine closes the
    client 5 s later (longer while the flight dump is written, at most 10 s more), tries once more
    20 s after that and gives up at 60 s; it does nothing while the client is already exiting,
    nothing but the first log line when the setting is off, and starts over if the screen goes.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>DisconnectCloseTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\Compatibility\ServerDisconnectClosePolicy.cs" Link="Engine\ServerDisconnectClosePolicy.cs" />
  </ItemGroup>

</Project>
