<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the Loot Editor's text-condition modes (src\RynthCore.Engine\UI\LootPatternText.cs):
    contains / doesn't contain / starts with / ends with / is exactly / regex written as VTank regex, what
    each pattern matches (case-insensitive, as RynthAi's evaluator), and patterns read back as the same
    mode and words (and anything else as regex).
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>LootPatternTextTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\UI\LootPatternText.cs" Link="Engine\LootPatternText.cs" />
  </ItemGroup>

</Project>
