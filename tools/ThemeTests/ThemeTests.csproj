<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the colour theme (Tom 2026-10-22: a new preset must never override the
    colours a player made, and players can save their own schemes).
    src\RynthCore.Engine\ImGui\RynthTheme.cs and ThemeSchemes.cs, compiled in, with stub
    UiBackgroundWriter (runs the save at once) and RynthLog. The theme reads its files once per
    process, so each case runs in a child process pointed at its own temp folder with
    RYNTHCORE_THEME_DIR. Never touches %AppData%\RynthCore.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ThemeTests</RootNamespace>
    <NoWarn>$(NoWarn);CS0162;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\ImGui\RynthTheme.cs" Link="Engine\RynthTheme.cs" />
    <Compile Include="..\..\src\RynthCore.Engine\ImGui\ThemeSchemes.cs" Link="Engine\ThemeSchemes.cs" />
  </ItemGroup>

</Project>
