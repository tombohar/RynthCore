<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the Inventory panel's multi-selection (src\RynthCore.Engine\ImGui\Panels\
    InventorySelection.cs, compiled in): click, Ctrl+click, Shift+click runs (both directions,
    Ctrl+Shift adding), select all, picked order, and forgetting items that left the inventory.
    Nothing native: no AC, no ImGui, no engine state.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>InventorySelectionTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\ImGui\Panels\InventorySelection.cs" Link="Engine\InventorySelection.cs" />
  </ItemGroup>

</Project>
