<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for src\RynthCore.Engine\Compatibility\AcMouseOverRules.cs (2026-10-08):
    a nameplate drawn under AC's windows may take a click only where AC's own mouse-over is
    the 3D world (gmSmartBoxUI, type 0x10000014, or the SmartBox wrapper, 0x10000030) - never on one of AC's windows - and
    keeps today's behaviour (takes it) whenever AC's UI state can't be read.
    The AC-side facts (offsets, the type id) are checked against acclient.exe by
    tools\ui_hooks_check.py.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>AcMouseOverTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\Compatibility\AcMouseOverRules.cs" Link="Engine\AcMouseOverRules.cs" />
  </ItemGroup>

</Project>
