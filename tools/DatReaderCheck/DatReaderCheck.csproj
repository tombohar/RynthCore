<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Checks a change to the dat code against the code it replaces, on the real dat files, read
    only. Covers the StatusAgent's reader and icon decoder (src\RynthCore.StatusAgent\Dat) and
    the engine's portal reader and icon decoder (src\RynthCore.Engine\UI\ScriptWindows\
    AcIconDecoder.cs), all compiled in. It uses only their API, so the same source builds
    against the old code (check out the base commit) and the new; each build writes a manifest
    and "diff" compares two:

      manifest <AC folder> <out>   every file in client_portal.dat and client_cell_1.dat through
                                   both readers (id, flags, offset, size, SHA-256 of the bytes),
                                   FindFile misses, landblock cell ids, EntriesInRange per type.
      icons <AC folder> <out>      every 0x06 texture through IconDecoder.Decode and
                                   AcIconDecoder.Decode (icon and UI limits): size and a SHA-256
                                   of the RGBA pixels; 3,000 composed underlay/icon/overlay stacks.
      diff <a> <b>                 compares two outputs. Timing lines ("#t") and the order of the
                                   list calls ("#o") are reported, not compared: the lists are
                                   compared as sets.

    Run: dotnet run -c Release (after the usual separator) icons "C:\Turbine\Asheron's Call" old.txt
    The RynthSuite twin, Tools\RynthCore.DatReaderCheck, covers RynthAi's reader and geometry.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>DatReaderCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.StatusAgent\Dat\*.cs" Link="StatusAgent\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\RynthCore.Engine\UI\ScriptWindows\AcIconDecoder.cs" Link="Engine\AcIconDecoder.cs" />
  </ItemGroup>

</Project>
