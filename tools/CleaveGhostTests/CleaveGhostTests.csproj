<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for two 2026-10-12 pieces (Drakkon, Tetsubo, Olthoi in 0x6146):
      src\RynthCore.Engine\ImGui\MonsterHud\CleaveHealth.cs - which nameplate a cleave/AoE hit's
        share of max health belongs to (AttackerNotification names the monster, no id), so the
        bars of monsters the server doesn't stream health for move too;
      src\RynthCore.Engine\Compatibility\ObjectFreshness.cs - when the server last sent anything
        about an object (the safety check behind plugin API v83 RemoveClientObject: a "ghost"
        creature the server talked about recently is real and is never removed).
    Both compiled in; no game, no engine.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>CleaveGhostTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\ImGui\MonsterHud\CleaveHealth.cs" Link="Engine\CleaveHealth.cs" />
    <Compile Include="..\..\src\RynthCore.Engine\Compatibility\ObjectFreshness.cs" Link="Engine\ObjectFreshness.cs" />
  </ItemGroup>

</Project>
