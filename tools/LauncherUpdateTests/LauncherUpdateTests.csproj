<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline tests for the launcher's Available plugins list, plugin installs with download
    progress and Cancel (RynthUpdater.Available.cs, DownloadProgress.cs), and the front page's
    update card (UpdateCardModel.cs), and plugin manifests' minEngineApi (a plugin build the
    installed engine would refuse is neither installed nor updated; "needs RynthCore X"
    instead). A throwaway key signs a feed served by a local
    HttpListener; plugins install into temp folders. Never opens the launcher window, never
    reads or writes outside %TEMP%.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LauncherUpdateTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.App.Avalonia\RynthUpdater.cs" Link="Linked\RynthUpdater.cs" />
    <Compile Include="..\..\src\RynthCore.App.Avalonia\RynthUpdater.MapPacks.cs" Link="Linked\RynthUpdater.MapPacks.cs" />
    <Compile Include="..\..\src\RynthCore.App.Avalonia\RynthUpdater.NavData.cs" Link="Linked\RynthUpdater.NavData.cs" />
    <Compile Include="..\..\src\RynthCore.App.Avalonia\RynthUpdater.Available.cs" Link="Linked\RynthUpdater.Available.cs" />
    <Compile Include="..\..\src\RynthCore.App.Avalonia\RynthUpdater.Rollback.cs" Link="Linked\RynthUpdater.Rollback.cs" />
    <Compile Include="..\..\src\RynthCore.App.Avalonia\PluginNames.cs" Link="Linked\PluginNames.cs" />
    <Compile Include="..\..\src\RynthCore.App\KnownServerCatalog.cs" Link="Linked\KnownServerCatalog.cs" />
    <Compile Include="..\..\src\RynthCore.App\LaunchServerProfile.cs" Link="Linked\LaunchServerProfile.cs" />
    <Compile Include="..\..\src\RynthCore.App.Avalonia\DownloadProgress.cs" Link="Linked\DownloadProgress.cs" />
    <Compile Include="..\..\src\RynthCore.App.Avalonia\UpdateCardModel.cs" Link="Linked\UpdateCardModel.cs" />
    <Compile Include="..\..\src\RynthCore.App.Avalonia\UpdateTrust.cs" Link="Linked\UpdateTrust.cs" />
    <Compile Include="..\..\src\RynthCore.Engine\Plugins\PluginContractVersion.cs" Link="Linked\PluginContractVersion.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Shared\RynthInstallPaths.cs" Link="Shared\RynthInstallPaths.cs" />
  </ItemGroup>

</Project>
