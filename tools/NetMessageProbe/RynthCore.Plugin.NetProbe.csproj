<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NetProbe: a test plugin for the v78 server-message stream. It asks for every message the
    SDK parses (RynthCore.PluginSdk.Net), parses what arrives on RynthPluginOnServerMessage
    and writes the first few of each kind, and a count every 30 s, to the RynthCore log
    ("NetProbe:"). For the in-game check only; not shipped.
    dotnet publish -c Release -o <a test folder>, then add the DLL in the launcher's Plugins tab.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <RootNamespace>RynthCore.Plugin.NetProbe</RootNamespace>
    <AssemblyName>RynthCore.Plugin.NetProbe</AssemblyName>
    <Platforms>x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <IlcArg Include="--runtimeopt:GCSegmentSize=800000" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RynthCore.PluginCore\RynthCore.PluginCore.csproj" />
    <ProjectReference Include="..\..\src\RynthCore.PluginSdk\RynthCore.PluginSdk.csproj" />
  </ItemGroup>

</Project>
