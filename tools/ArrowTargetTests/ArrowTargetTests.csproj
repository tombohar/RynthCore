<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the RynthNav Arrow window's one target (src\RynthCore.Engine\UI\Data\
    ArrowTarget.cs, compiled in): where the target came from (chat coords, a route, the arrow),
    its label, and whether the route list under the arrow belongs to it.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>ArrowTargetTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\UI\Data\ArrowTarget.cs" Link="Engine\ArrowTarget.cs" />
  </ItemGroup>

</Project>
