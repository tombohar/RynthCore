<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the user hotkeys (Settings > Hotkeys, /rc hotkey). src\RynthCore.Engine\
    Hotkeys\HotkeyModel.cs is compiled in as is (it has no engine dependencies): combo parsing and
    formatting, matching with exact modifiers, the key-down edge (auto-repeat never re-fires; the
    keystroke a hotkey takes is eaten, other keys pass), the typing rule (never while a RynthCore
    text box or AC's chat has the keyboard), conflict warnings, the /rc hotkey parser and the
    hotkeys.txt round trip. Uses RYNTHCORE_HOTKEYS_FILE (a temp file); never touches
    %LOCALAPPDATA%\RynthCore.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>HotkeyTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\Hotkeys\HotkeyModel.cs" Link="Engine\HotkeyModel.cs" />
  </ItemGroup>

</Project>
