<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the launcher's shared settings with "Decal + RynthCore" accounts
    (src\RynthCore.App\AppSettingsStore.cs and DecalAccountModes.cs, compiled in): the choice
    lives in decal-accounts.json, appsettings.json never holds a value an older launcher can't
    read, migration of a file that does, and what happens when an older launcher edits the
    accounts; and saved account passwords (DPAPI-encrypted, AccountPasswordProtection.cs): round
    trip, migration of a plain-text file, undecryptable blobs, nothing leaking into files or notes;
    and the crash-dump kill hold (CrashDumpWriterRule.cs): which client a createdump.exe /
    WerFault.exe command line names, and how long the launcher's kills wait for it.
    Works in a temp folder, never in %APPDATA%\RynthCore. Windows only (DPAPI).
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>LauncherSettingsTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.App\AppSettings.cs" Link="App\AppSettings.cs" />
    <Compile Include="..\..\src\RynthCore.App\AppSettingsStore.cs" Link="App\AppSettingsStore.cs" />
    <Compile Include="..\..\src\RynthCore.App\DecalAccountModes.cs" Link="App\DecalAccountModes.cs" />
    <Compile Include="..\..\src\RynthCore.App\InjectionMode.cs" Link="App\InjectionMode.cs" />
    <Compile Include="..\..\src\RynthCore.App\LaunchAccountProfile.cs" Link="App\LaunchAccountProfile.cs" />
    <Compile Include="..\..\src\RynthCore.App\AccountPasswordProtection.cs" Link="App\AccountPasswordProtection.cs" />
    <Compile Include="..\..\src\RynthCore.App\SavedPasswordReveal.cs" Link="App\SavedPasswordReveal.cs" />
    <Compile Include="..\..\src\RynthCore.App\LaunchServerProfile.cs" Link="App\LaunchServerProfile.cs" />
    <Compile Include="..\..\src\RynthCore.App\KnownServerCatalog.cs" Link="App\KnownServerCatalog.cs" />
    <Compile Include="..\..\src\RynthCore.App\AcLaunchArgumentBuilder.cs" Link="App\AcLaunchArgumentBuilder.cs" />
    <Compile Include="..\..\src\RynthCore.App\AcClientCommandLine.cs" Link="App\AcClientCommandLine.cs" />
    <Compile Include="..\..\src\RynthCore.App\FirstLoginRules.cs" Link="App\FirstLoginRules.cs" />
    <Compile Include="..\..\src\RynthCore.App\AccountServerRules.cs" Link="App\AccountServerRules.cs" />
    <Compile Include="..\..\src\RynthCore.App\UserPrefsSwapRecovery.cs" Link="App\UserPrefsSwapRecovery.cs" />
    <Compile Include="..\..\src\RynthCore.App\CrashDumpWriterRule.cs" Link="App\CrashDumpWriterRule.cs" />
    <Compile Include="..\..\src\RynthCore.App\AcWindowRestoreRule.cs" Link="App\AcWindowRestoreRule.cs" />
  </ItemGroup>

</Project>
