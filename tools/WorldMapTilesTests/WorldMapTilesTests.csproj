<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the World Map's tile loader (DXT1 version 2 files, switching files) and its projection (Panels\MapProjection.cs, compiled in) (src\RynthCore.Engine\ImGui\WorldMapTiles.cs,
    compiled in; DX9Backend is a stub here): the worldmap.rmap header and tile layout as
    RynthNav.Baker writes it with its map-tiles option, the tile lookups, the texture cap and eviction,
    and that Shutdown releases every texture.
    Run: dotnet run -c Release, optionally with the paths of a worldmap.rmap and a worldmap.vec as the arguments   (exit 0 = pass, 1 = fail; a real file is checked too when given)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>WorldMapTilesTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\ImGui\WorldMapTiles.cs" Link="Engine\WorldMapTiles.cs" />
    <Compile Include="..\..\src\RynthCore.Engine\ImGui\Panels\MapProjection.cs" Link="Engine\MapProjection.cs" />
    <Compile Include="..\..\src\RynthCore.Engine\ImGui\WorldMapVectors.cs" Link="Engine\WorldMapVectors.cs" />
  </ItemGroup>

</Project>
