<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the opt-in in-world hot-reload hold (2026-10-18, from SilentKelpie's PR 6):
    src\RynthCore.Engine\ReloadInWorldGate.cs. Off by default: never holds. On: an automatic reload
    waits while the player is in the world; a reload asked for by hand is never held; leaving the
    world (or switching the hold off, or a hand reload arriving mid-wait) releases it; at the
    HoldReloadInWorldMaxMinutes bound it gives up, logs once, and the reload goes ahead; a
    throwing query never wedges. Clock and sleep are fakes.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>ReloadInWorldGateTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\ReloadInWorldGate.cs" Link="Engine\ReloadInWorldGate.cs" />
  </ItemGroup>

</Project>
