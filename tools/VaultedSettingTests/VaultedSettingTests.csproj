<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the Settings > Navigation "Vaulted Dungeons" row (2026-10-18; the keeper is
    Silentkelpie's, RynthSuite PR 12): the mirror of RynthAi's EnableVaultedDungeons master switch in
    UI\Data\SettingsData.cs. Nothing is claimed until RynthAi sends the value (an older RynthAi omits
    it: the row stays hidden and a save sends null, which RynthAi leaves alone); the row edits only
    that property; it reads Off by default.
    The engine has no test seam for SettingsData.cs (it pulls in the whole ImGui layer), so this
    references the built engine assembly and reaches the internal types by reflection. x86, like
    the engine: needs the x86 .NET runtime (C:\Program Files (x86)\dotnet).
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Platforms>x86</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>VaultedSettingTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RynthCore.Engine\RynthCore.Engine.csproj" />
  </ItemGroup>

</Project>
