<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the Meta editor's rules (2026-10-05 clean-up), compiled in from
    src/RynthCore.Engine/UI/Data: MetaEditing.cs (new state names, the autosave debounce, the
    one .bak per session, placeholder rule, Add condition / action, finding a rule again by
    content), MetaLocation.cs ("Set current" text for landblock / landcell, against a copy of
    RynthAi's MetaManager reading; RynthSuite's RynthAiHostTests check the real one) and
    MetaRuleDto.cs, the rule list's text (MetaRowText.cs) and its timers (MetaStateClock.cs). Nothing native: no AC, no ImGui, no files.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>MetaEditTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\UI\Data\MetaEditing.cs" Link="Engine\MetaEditing.cs" />
    <Compile Include="..\..\src\RynthCore.Engine\UI\Data\MetaLocation.cs" Link="Engine\MetaLocation.cs" />
    <Compile Include="..\..\src\RynthCore.Engine\UI\Data\MetaRuleDto.cs" Link="Engine\MetaRuleDto.cs" />
    <Compile Include="..\..\src\RynthCore.Engine\UI\Data\MetaRowText.cs" Link="Engine\MetaRowText.cs" />
    <Compile Include="..\..\src\RynthCore.Engine\UI\Data\MetaStateClock.cs" Link="Engine\MetaStateClock.cs" />
  </ItemGroup>

</Project>
