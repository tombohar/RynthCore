<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for the toolbar's text size (the "chrome" row of PanelTextScale).
    src\RynthCore.Engine\UI\PanelTextScale.cs, compiled in, with a stub ImGuiFonts. The toolbar's
    row must survive a window being sized (SetForWindow's reset loop), be baked even when sizing
    per panel is off (StepsInUse), be left alone by All Panels changes, stay unbaked at 0, clamp,
    and round-trip through the file. PanelTextScale reads its file path once per process, so each
    case runs in a child process pointed at a temp file with RYNTHCORE_PANEL_TEXT_SIZE. Never
    touches %LOCALAPPDATA%\RynthCore.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>PanelTextScaleTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\UI\PanelTextScale.cs" Link="Engine\PanelTextScale.cs" />
  </ItemGroup>

</Project>
