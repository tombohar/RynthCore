<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline checks for RynthChat's Discord relay (src\RynthCore.Engine\UI\Data\Discord\, the
    engine-free parts compiled in): speech parsing, which routes take a line and under which
    label, the Discord text, scrollback detection, settings save / load, the request body and
    429 handling, a route's send queue, and DPAPI round trips. Nothing is sent.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>ChatDiscordTests</RootNamespace>
    <!-- DiscordRoute.Status is written by the engine's pump, which isn't compiled in here. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\RynthCore.Engine\UI\Data\Discord\ChatSpeech.cs" Link="Engine\ChatSpeech.cs" />
    <Compile Include="..\..\src\RynthCore.Engine\UI\Data\Discord\ChatDiscordLogic.cs" Link="Engine\ChatDiscordLogic.cs" />
    <Compile Include="..\..\src\RynthCore.Engine\UI\Data\Discord\ChatDiscordSettings.cs" Link="Engine\ChatDiscordSettings.cs" />
    <Compile Include="..\..\src\RynthCore.Engine\UI\Data\Discord\DiscordFormat.cs" Link="Engine\DiscordFormat.cs" />
    <Compile Include="..\..\src\RynthCore.Engine\UI\Data\Discord\DiscordClient.cs" Link="Engine\DiscordClient.cs" />
    <Compile Include="..\..\src\RynthCore.Engine\UI\Data\Discord\DiscordSecrets.cs" Link="Engine\DiscordSecrets.cs" />
    <Compile Include="..\..\src\RynthCore.Engine\UI\Data\Discord\DiscordRouteQueue.cs" Link="Engine\DiscordRouteQueue.cs" />
  </ItemGroup>

</Project>
