<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RynthCore.StatusAgent — OPTIONAL, runs on the operator's own PC only.

    Reads the LOCAL per-client status files the engine writes (when the user
    opts in via EnableStatusExport) and forwards a rolled-up status payload to
    a USER-CONFIGURED endpoint. It is NOT injected into acclient.exe, NOT part
    of the installer, and sends nothing until an Endpoint URL is set in
    %APPDATA%\RynthCore\statusagent.json. Delete this project folder + its .sln
    entry to remove it entirely.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RynthCore.StatusAgent</RootNamespace>
    <AssemblyName>RynthCore.StatusAgent</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Screen-stream capture (GDI BitBlt + JPEG encode). Windows-only; the agent is net*-windows. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <!-- WebRTC HD video mode: pure-managed RTCPeerConnection + H.264 RTP packetisation (proven in the spike). -->
    <PackageReference Include="SIPSorcery" Version="8.0.14" />
  </ItemGroup>

</Project>
