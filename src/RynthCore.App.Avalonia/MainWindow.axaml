<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RynthCore.App.Avalonia"
        x:Class="RynthCore.App.Avalonia.MainWindow"
        Width="1280"
        Height="860"
        MinWidth="820"
        MinHeight="560"
        Title="RynthCore"
        Background="#0B1218"
        Icon="avares://RynthCore.App.Avalonia/LogoCore.ico">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="BorderBrush" Value="#243742" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8,8,0,0" />
      <Setter Property="Background" Value="#0F161D" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Background" Value="#1A2E38" />
      <Setter Property="BorderBrush" Value="#26C1A6" />
      <Setter Property="Foreground" Value="#26C1A6" />
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Background" Value="#1F3642" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*" Margin="14">
    <Border Grid.Row="0"
            Padding="14"
            CornerRadius="16"
            Background="#132028"
            BorderBrush="#26C1A6"
            BorderThickness="1"
            Margin="0,0,0,10">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <Border Grid.Column="0"
                Background="#102A2C"
                CornerRadius="10"
                Padding="0"
                Width="82"
                HorizontalAlignment="Left"
                Margin="0,0,12,0"
                ClipToBounds="True">
          <Image Source="avares://RynthCore.App.Avalonia/LogoCore.jpg" Stretch="Uniform" />
        </Border>

        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="RynthCore"
                     FontSize="24"
                     FontWeight="Bold"
                     Foreground="#26C1A6" />
          <TextBlock x:Name="HeaderVersionText"
                     FontSize="11"
                     Foreground="#9AA8B3" />
          <TextBlock x:Name="HeaderUpdateText"
                     IsVisible="False"
                     FontSize="12"
                     Foreground="#F2C14E" />
        </StackPanel>

        <GridSplitter Grid.Column="2"
                      Width="8"
                      ResizeDirection="Columns"
                      Background="Transparent" />

        <StackPanel Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center"
                    Margin="10,0,0,0">
          <CheckBox x:Name="AutoLaunchHeaderCheckBox"
                    Content="Auto Launch"
                    VerticalAlignment="Center"
                    Foreground="#EAF0F4" />
          <Button x:Name="HeaderLaunchButton"
                  Content="LAUNCH"
                  FontSize="16"
                  FontWeight="Black"
                  Background="#26C1A6"
                  Foreground="#0B1218"
                  Padding="16,8"
                  VerticalAlignment="Center"
                  CornerRadius="8" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="3*,Auto,2*">
      <TabControl x:Name="MainTabs" Grid.Column="0" Margin="14,0,0,0" Padding="0">
        <TabItem Header="Launcher">
          <!-- Named so the tab keeps the player's scroll position (MainWindow.KeepLauncherScroll);
               * rows inside this scroll must not be used (they claim infinite height and clip
               Updates/Launch Targets). -->
          <ScrollViewer x:Name="LauncherScroll"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" Margin="6">
              <!-- Updates: the card is built by UpdateCardModel (MainWindow.RefreshUpdateCard). -->
              <Border x:Name="UpdateCardBorder" Background="#132028" CornerRadius="16" Padding="18"
                      BorderBrush="#243742" BorderThickness="1">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                      <TextBlock x:Name="UpdateCardTitle" Text="Updates" FontSize="16" FontWeight="SemiBold"
                                 Foreground="#26C1A6" TextWrapping="Wrap" />
                      <TextBlock x:Name="UpdateCardDetail" Text="Not checked yet." TextWrapping="Wrap" Foreground="#9AA8B3" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                      <Button x:Name="UpdateCardActionButton" IsVisible="False" Margin="0,0,8,6"
                              Background="#26C1A6" Foreground="#0B1218" FontWeight="SemiBold" />
                      <Button x:Name="CheckUpdatesButton" Content="Check for updates" Margin="0,0,0,6" />
                      <Button x:Name="RollbackButton" Content="Roll back…" Margin="8,0,0,6" IsVisible="False"
                              ToolTip.Tip="Go back to an earlier RynthCore release if this one broke something. Updates then wait for a newer release." />
                    </WrapPanel>
                  </Grid>
                  <StackPanel x:Name="UpdateCardWhatsNewPanel" Spacing="2" IsVisible="False" />
                  <Grid x:Name="DownloadArea" ColumnDefinitions="*,Auto" IsVisible="False">
                    <ProgressBar x:Name="DownloadProgressBar" Grid.Column="0" Minimum="0" Maximum="100"
                                 Height="10" MinHeight="10" VerticalAlignment="Center"
                                 Foreground="#26C1A6" Background="#0F161D" />
                    <Button x:Name="CancelDownloadButton" Grid.Column="1" Content="Cancel" Margin="10,0,0,0"
                            ToolTip.Tip="Stops the download. Nothing half-installed is left behind: the partial file is deleted and what you have stays as it is." />
                  </Grid>
                  <Button x:Name="UpdateCardNewPluginsButton" IsVisible="False" HorizontalAlignment="Left"
                          Background="Transparent" BorderThickness="0" Padding="0" Foreground="#F2C14E" />
                </StackPanel>
              </Border>

              <!-- The World Map's optional sizes (MainWindow.RefreshMapPacksCard; the feed's "mappacks"). -->
              <Border x:Name="MapPacksCard" Background="#132028" CornerRadius="16" Padding="18" IsVisible="False"
                      BorderBrush="#243742" BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Text="World map detail" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                  <TextBlock TextWrapping="Wrap" Foreground="#9AA8B3"
                             Text="The in-game World Map comes in sizes. The standard one is installed with RynthNav; the sharper ones are optional downloads. The map uses the best size you have installed, and its Show menu lets you switch between them." />
                  <StackPanel x:Name="MapPacksPanel" Spacing="8" />
                </StackPanel>
              </Border>

              <Border Background="#132028" CornerRadius="16" Padding="18">
                <StackPanel Spacing="8">
                  <TextBlock Text="Launch Targets" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                  <TextBlock Text="Check the account profiles you want remembered as launch targets. This is persisted using the same settings store as the current host."
                             TextWrapping="Wrap"
                             Foreground="#9AA8B3" />
                  <ScrollViewer MaxHeight="240">
                    <StackPanel x:Name="LaunchTargetsPanel" Spacing="2" Margin="0,6,0,0" />
                  </ScrollViewer>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SelectAllTargetsButton" Content="Select All" />
                    <Button x:Name="ClearTargetsButton" Content="Clear" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Background="#132028" CornerRadius="16" Padding="18">
                <StackPanel Spacing="8">
                  <TextBlock Text="Launcher Surface" FontSize="19" FontWeight="Bold" Foreground="#EAF0F4" />
                  <TextBlock Text="Configure your server and account profiles below. These are used to build the launch targets list above."
                             TextWrapping="Wrap"
                             Foreground="#9AA8B3" />
                </StackPanel>
              </Border>

              <!-- All-Auto rows: a * row under an outer ScrollViewer expands wrongly and
                   pushes Updates + Launch Targets above the clip (unreachable by scroll). -->
              <Grid ColumnDefinitions="*,Auto,*">
                <Border Grid.Column="0" Background="#132028" CornerRadius="16" Padding="18" MinWidth="260">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Text="Server Profiles" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                    <TextBlock Grid.Row="1"
                               Text="Create and edit emulator/server definitions here."
                               TextWrapping="Wrap"
                               Foreground="#9AA8B3"
                               Margin="0,8,0,0" />
                    <ListBox Grid.Row="2"
                             x:Name="ServerProfilesList"
                             MinHeight="200"
                             MaxHeight="280"
                             Background="#0F161D"
                             BorderBrush="#243742"
                             Foreground="#EAF0F4"
                             Margin="0,8,0,0" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                      <Button x:Name="AddServerButton" Content="Add Server" />
                      <Button x:Name="EditServerButton" Content="Edit Selected" />
                      <Button x:Name="DeleteServerButton" Content="Delete" />
                    </StackPanel>
                  </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="12"
                              ResizeDirection="Columns"
                              Background="Transparent" />

                <Border Grid.Column="2" Background="#132028" CornerRadius="16" Padding="18" MinWidth="260">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Text="Account Profiles" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                    <TextBlock Grid.Row="1"
                               Text="Passwords are saved encrypted for this Windows user."
                               TextWrapping="Wrap"
                               Foreground="#9AA8B3"
                               Margin="0,8,0,0" />
                    <ListBox Grid.Row="2"
                             x:Name="AccountProfilesList"
                             MinHeight="200"
                             Background="#0F161D"
                             BorderBrush="#243742"
                             Foreground="#EAF0F4"
                             Margin="0,8,0,0" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                      <Button x:Name="AddAccountButton" Content="Add Account" />
                      <Button x:Name="EditAccountButton" Content="Edit Selected" />
                      <Button x:Name="DeleteAccountButton" Content="Delete" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>

              <Border Background="#132028" CornerRadius="16" Padding="18">
                <Grid ColumnDefinitions="*,Auto,*">
                  <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                    <TextBlock Text="This stays password-safe, but gives us the next useful launcher step: a clear primary pair and remembered targets."
                               TextWrapping="Wrap"
                               Foreground="#9AA8B3" />
                    <WrapPanel Orientation="Horizontal" ItemWidth="176" ItemHeight="40">
                      <Button x:Name="LaunchPrimaryButton" Content="Launch Primary Pair" HorizontalAlignment="Left" Margin="0,0,8,8" />
                      <Button x:Name="LaunchCheckedTargetsButton" Content="Launch Checked Targets" HorizontalAlignment="Left" Margin="0,0,8,8" />
                      <Button x:Name="MarkSelectedTargetButton" Content="Add Primary To Targets" HorizontalAlignment="Left" Margin="0,0,8,0" />
                    </WrapPanel>
                  </StackPanel>

                  <GridSplitter Grid.Column="1"
                                Width="12"
                                ResizeDirection="Columns"
                                Background="Transparent" />

                  <StackPanel Grid.Column="2" Spacing="8">
                    <TextBlock Text="Launch Preview" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                    <TextBlock x:Name="LaunchPreviewText"
                               Text="Choose a valid server and account profile to preview the launch command shape."
                               TextWrapping="Wrap"
                               Foreground="#EAF0F4" />
                    <TextBlock Text="Passwords stay masked in this preview."
                               Foreground="#9AA8B3" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border Background="#132028" CornerRadius="16" Padding="18">
                <StackPanel Spacing="8">
                  <TextBlock Text="Selection Summary" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                  <TextBlock x:Name="SummaryText"
                             Text="Choose a server and account profile to preview the launch pair."
                             TextWrapping="Wrap"
                             Foreground="#EAF0F4" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="PluginsTab" Header="Plugins">
          <ScrollViewer x:Name="PluginsScroll">
            <StackPanel Spacing="12" Margin="6">
              <Border Background="#132028" CornerRadius="16" Padding="18">
                <StackPanel Spacing="8">
                  <TextBlock Text="Updates" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                  <!-- Compact: the update card with its buttons is on the Launcher tab. -->
                  <TextBlock x:Name="UpdateStatusText"
                             Text="Not checked yet."
                             TextWrapping="Wrap"
                             Foreground="#9AA8B3" />
                  <ProgressBar x:Name="PluginsTabProgressBar" Minimum="0" Maximum="100" Height="6" MinHeight="6"
                               IsVisible="False" Foreground="#26C1A6" Background="#0F161D" />
                  <Button x:Name="ShowUpdateCardButton" Content="Updates on the Launcher tab" HorizontalAlignment="Left"
                          Background="Transparent" BorderThickness="0" Padding="0" Foreground="#26C1A6" />
                  <CheckBox x:Name="AutoUpdatePluginsCheckBox"
                            Content="Update plugins automatically (a running bot keeps its version until AC restarts)"
                            Foreground="#EAF0F4" />
                </StackPanel>
              </Border>
              <Border Background="#132028" CornerRadius="16" Padding="18">
                <StackPanel Spacing="8">
                  <TextBlock Text="Usage statistics" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                  <CheckBox x:Name="UsageStatsCheckBox"
                            Content="Help improve RynthCore: send an anonymous usage report once a day"
                            Foreground="#EAF0F4" />
                  <TextBlock x:Name="UsageStatsWhatText" TextWrapping="Wrap" Foreground="#9AA8B3" />
                  <TextBlock x:Name="UsageStatsNeverText" TextWrapping="Wrap" Foreground="#9AA8B3" />
                  <TextBlock x:Name="UsageStatsStopText" TextWrapping="Wrap" Foreground="#9AA8B3" />
                  <Button x:Name="ShowUsageReportButton" Content="Show what is sent" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border Background="#132028" CornerRadius="16" Padding="18">
                <StackPanel Spacing="8">
                  <TextBlock Text="Plugins" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                  <TextBlock Text="The plugins RynthCore loads. Untick one to skip it; the X takes it out of the list (its files stay on disk). RynthSuite plugins you don't have are under Available plugins below; plugins for one game server are on the Server plugins tab. Add Plugin is for any other plugin DLL."
                             TextWrapping="Wrap"
                             Foreground="#9AA8B3" />
                  <StackPanel x:Name="PluginLoadoutPanel" Spacing="10" />
                  <Button x:Name="AddPluginDllButton" Content="Add Plugin" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border x:Name="AvailablePluginsBorder" Background="#132028" CornerRadius="16" Padding="18">
                <StackPanel Spacing="8">
                  <TextBlock Text="Available plugins" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                  <TextBlock x:Name="AvailablePluginsHint"
                             Text="Plugins you can add appear here after the first update check."
                             TextWrapping="Wrap"
                             Foreground="#9AA8B3" />
                  <StackPanel x:Name="AvailablePluginsPanel" Spacing="10" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Server plugins: one per game server, kept apart from the regular plugins. RynthCore loads
             one only when you connect to its server, so installing several costs nothing elsewhere. -->
        <TabItem x:Name="ServerPluginsTab" Header="Server plugins">
          <ScrollViewer>
            <StackPanel Spacing="12" Margin="6">
              <Border Background="#132028" CornerRadius="16" Padding="18">
                <StackPanel Spacing="8">
                  <TextBlock Text="Your server plugins" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                  <TextBlock Text="Extras for one game server each. RynthCore loads a server plugin only when you connect to its server; everywhere else it stays off. Untick one to skip it; the X takes it out of the list (its files stay on disk)."
                             TextWrapping="Wrap"
                             Foreground="#9AA8B3" />
                  <TextBlock x:Name="ServerPluginsEmptyText" Text="No server plugins installed."
                             Foreground="#6F7F8A" IsVisible="False" />
                  <StackPanel x:Name="ServerPluginLoadoutPanel" Spacing="10" />
                </StackPanel>
              </Border>
              <Border Background="#132028" CornerRadius="16" Padding="18">
                <StackPanel Spacing="8">
                  <TextBlock Text="Available server plugins" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                  <TextBlock x:Name="AvailableServerPluginsHint"
                             Text="Server plugins you can add appear here after the first update check."
                             TextWrapping="Wrap"
                             Foreground="#9AA8B3" />
                  <StackPanel x:Name="AvailableServerPluginsPanel" Spacing="10" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Runtime">
          <ScrollViewer>
            <StackPanel Spacing="12" Margin="6">
              <Grid ColumnDefinitions="*,Auto,*">
                <Border Grid.Column="0" Background="#132028" CornerRadius="16" Padding="18" MinWidth="280">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Paths" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                    <TextBlock Text="These values are backed by the shared app settings store and persist across sessions."
                               TextWrapping="Wrap"
                               Foreground="#9AA8B3" />
                    <TextBlock Text="AC Client Path" Foreground="#EAF0F4" />
                    <TextBox x:Name="AcClientPathTextBox" Watermark="C:\Games\Asheron's Call\acclient.exe" />
                    <TextBlock Text="Engine Path" Foreground="#EAF0F4" />
                    <TextBox x:Name="EnginePathTextBox" Watermark="C:\Games\RynthCore\Runtime\RynthCore.Engine.dll" />
                    <TextBlock Text="Extra Launch Arguments" Foreground="#EAF0F4" />
                    <TextBox x:Name="LaunchArgumentsTextBox"
                             Watermark="Optional arguments added after each account's login"
                             ToolTip.Tip="Added to the end of every launch's command line, after the account, password and server the profiles set. It can't contain -a, -v, -h, -p or -rodat: set those in the account and server profiles. One line."
                             AcceptsReturn="False"
                             TextWrapping="Wrap" />
                    <Button x:Name="SavePathsButton"
                            Content="Save Runtime Paths"
                            HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="12"
                              ResizeDirection="Columns"
                              Background="Transparent" />

                <Border Grid.Column="2" Background="#132028" CornerRadius="16" Padding="18" MinWidth="280">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Launch Behavior" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                    <TextBlock Text="Host-side toggles for launch and injection behavior."
                               TextWrapping="Wrap"
                               Foreground="#9AA8B3" />
                    <CheckBox x:Name="AllowMultipleClientsCheckBox" Content="Allow multiple clients" />
                    <CheckBox x:Name="SkipIntroVideosCheckBox" Content="Skip intro videos" />
                    <CheckBox x:Name="SkipLoginLogosCheckBox" Content="Skip login logos" />
                    <CheckBox x:Name="AutoInjectAfterLaunchCheckBox" Content="Auto inject after launch" />
                    <CheckBox x:Name="WatchForAcStartCheckBox"
                              Content="Auto-inject into externally-launched AC"
                              ToolTip.Tip="Watches for acclient.exe processes started by other launchers (Decal, UBLoader, ThwargLauncher). Once the client's graphics state is stable, RynthCore is injected automatically. Skips processes the launcher started itself or that already have RynthCore loaded." />
                    <CheckBox x:Name="OverrideWindowTitleCheckBox"
                              Content="Rewrite AC window titles per account"
                              ToolTip.Tip="Replaces &quot;Asheron's Call&quot; with &quot;Account / Character @ Server&quot; on tracked clients so multi-box taskbars are readable. Untracked external clients are left alone." />
                    <CheckBox x:Name="InjectAllRunningAcCheckBox" Content="Inject all running AC sessions" />
                    <TextBlock Text="Logging level (applies live)" Foreground="#EAF0F4" Margin="0,4,0,0" />
                    <ComboBox x:Name="LoggingLevelComboBox" SelectedIndex="3"
                              ToolTip.Tip="Engine log threshold. Written to engine.json immediately; running clients pick it up within a second. Off = errors only.">
                      <ComboBoxItem Content="Off" />
                      <ComboBoxItem Content="Error" />
                      <ComboBoxItem Content="Warning" />
                      <ComboBoxItem Content="Info" />
                      <ComboBoxItem Content="Debug" />
                      <ComboBoxItem Content="Trace" />
                    </ComboBox>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,8,0,0">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Inter-launch stagger (ms)" Foreground="#EAF0F4" VerticalAlignment="Center" Margin="0,0,8,6" />
                      <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="LaunchStaggerMsBox" Minimum="0" Maximum="5000" Increment="50" Width="120" Margin="0,0,0,6" />

                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Crash-relaunch limit per window" Foreground="#EAF0F4" VerticalAlignment="Center" Margin="0,0,8,6" />
                      <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="CrashRelaunchLimitBox" Minimum="1" Maximum="20" Increment="1" Width="120" Margin="0,0,0,6" />

                      <TextBlock Grid.Row="2" Grid.Column="0" Text="Crash-relaunch window (minutes)" Foreground="#EAF0F4" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="CrashRelaunchWindowBox" Minimum="1" Maximum="60" Increment="1" Width="120" />
                    </Grid>

                    <CheckBox x:Name="KillStuckClientsCheckBox"
                              Content="Kill stuck clients (pre- and post-login)"
                              ToolTip.Tip="Kills RynthCore-mode acclient.exe processes we launched that are stuck in either: (1) never reached login within the timeout (patcher hangs, char-select sit, login errors), or (2) logged out / disconnected and sat there longer than the timeout (disconnect dialog, idle char-select). Decal-mode clients are skipped (no engine = no login signal)."
                              Margin="0,8,0,4" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="Stuck-client timeout (seconds)" Foreground="#EAF0F4" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <NumericUpDown Grid.Column="1" x:Name="StuckClientTimeoutBox" Minimum="15" Maximum="600" Increment="15" Width="120" />
                    </Grid>

                    <Button x:Name="SaveBehaviorButton"
                            Content="Save Launch Behavior"
                            HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </Grid>

              <Border Background="#132028" CornerRadius="16" Padding="18">
                <StackPanel Spacing="8">
                  <TextBlock Text="Engine Settings" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                  <TextBlock Text="These flags are read by RynthCore.Engine on each AC client launch. They write to %APPDATA%\RynthCore\engine.json — other engine flags in that file are preserved untouched."
                             TextWrapping="Wrap"
                             Foreground="#9AA8B3" />
                  <CheckBox x:Name="EnableImGuiBackendCheckBox"
                            Content="ImGui panels (preview)"
                            ToolTip.Tip="When ON, the engine runs its in-client ImGui layer, which docked panels move to as their ImGui versions are finished (choose per panel with /rc ui). Popped-out panels stay Avalonia windows. Costs nothing while no ImGui panel is open. Takes effect on next AC client launch or engine reload (RL)." />
                </StackPanel>
              </Border>

              <!-- Live logging switches: engine categories (engine.json) and RynthAi categories/events
                   (diagnostics.json). Rows are built in code (MainWindow.Logging.cs). -->
              <Border Background="#132028" CornerRadius="16" Padding="18">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Logging" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Name="ReloadLoggingButton" Content="Reload" />
                  </Grid>
                  <TextBlock Text="Every change is saved immediately and applies to running clients without a restart (engine within 1 s, RynthAi within 2 s). Set any Trace or Debug item to Info to see it in the normal log; Off silences it."
                             TextWrapping="Wrap"
                             Foreground="#9AA8B3" />
                  <Expander Header="Engine categories" IsExpanded="True" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4">
                      <TextBlock Text="The level each category's lines are written at. A line shows when its level is within the global Logging level above (Info = normal log)."
                                 TextWrapping="Wrap" Foreground="#9AA8B3" />
                      <StackPanel x:Name="EngineLogCategoriesPanel" Spacing="2" />
                    </StackPanel>
                  </Expander>
                  <Expander Header="RynthAi categories" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Where each RynthAi category's trace lines go: Off = dropped, Trace = Logs\Diagnostics\Trace file only, Info = trace file and the normal log."
                                 TextWrapping="Wrap" Foreground="#9AA8B3" />
                      <StackPanel x:Name="RynthAiLogCategoriesPanel" Spacing="2" />
                    </StackPanel>
                  </Expander>
                  <Expander Header="RynthAi key events" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Named milestones (Hub login, options refresh, ...). Off = dropped, Trace = trace file while that category is traced, Info = normal log."
                                 TextWrapping="Wrap" Foreground="#9AA8B3" />
                      <StackPanel x:Name="RynthAiLogEventsPanel" Spacing="2" />
                    </StackPanel>
                  </Expander>
                  <TextBlock x:Name="LoggingStatusText" TextWrapping="Wrap" Foreground="#9AA8B3" />
                </StackPanel>
              </Border>

              <Border Background="#132028" CornerRadius="16" Padding="18">
                <StackPanel Spacing="8">
                  <TextBlock Text="Recovery Actions" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
                  <TextBlock Text="Use these when AC is already running and you need to attach RynthCore manually or refresh the live session readout."
                             TextWrapping="Wrap"
                             Foreground="#9AA8B3" />
                  <WrapPanel Orientation="Horizontal" ItemWidth="176" ItemHeight="40">
                    <Button x:Name="InjectRunningAcButton" Content="Inject Into Running AC" Margin="0,0,8,8" />
                    <Button x:Name="RefreshSessionsButton" Content="Refresh Sessions" Margin="0,0,8,8" />
                    <Button x:Name="ResetOverlayBarButton" Content="Reset Overlay Bar" Margin="0,0,8,8"
                            ToolTip.Tip="Drags the in-game RynthCore overlay bar back to the top-left corner. Use this if the bar was moved off-screen and can no longer be reached. Applies to every running RynthCore client." />
                    <Button x:Name="CheckDecalBridgeButton" Content="Check Decal bridge" Margin="0,0,8,8"
                            ToolTip.Tip="For Decal + RynthCore (experimental): checks whether a client started now will load the RynthCore Decal bridge - where Decal reads its plugin list on this PC, whether the bridge is listed and enabled there, Decal's version and its .NET part. Changes nothing unless you press Repair." />
                    <Button x:Name="RepairDecalButton" Content="Repair Decal" Margin="0,0,8,8"
                            ToolTip.Tip="For Decal plugins that don't show up: Windows can make Decal read an old per-user copy of its settings (left by an earlier RynthCore, or by Decal itself), which hides plugins installed since. This backs that copy up to a .reg file in %APPDATA%\RynthCore and removes it, after asking. Close Asheron's Call first." />
                    <Button x:Name="FixFolderPermissionsButton" Content="Fix folder permissions" Margin="0,0,8,8"
                            ToolTip.Tip="When RynthAi metas, navs, loot or settings profiles don't save: gives your Windows account write access to the RynthSuite and RynthCore folders and clears read-only on their files (one administrator prompt). Also tells you when Windows Security's Controlled folder access is blocking the game client." />
                  </WrapPanel>
                  <TextBlock Text="Manual inject target scope follows the 'Inject all running AC sessions' launch behavior toggle. Reset Overlay Bar signals all running RynthCore clients via the dispatch file."
                             TextWrapping="Wrap"
                             Foreground="#9AA8B3" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Activity">
          <ScrollViewer>
            <StackPanel Spacing="12" Margin="6">
              <Border Background="#132028" CornerRadius="16" Padding="18">
                <StackPanel Spacing="8">
                  <TextBlock Text="Session Activity" FontSize="19" FontWeight="Bold" Foreground="#EAF0F4" />
                  <TextBlock Text="Launcher actions, profile edits, runtime decisions, injection output, and future host events surface here."
                             TextWrapping="Wrap"
                             Foreground="#9AA8B3" />
                  <ListBox x:Name="ActivityList"
                           MinHeight="440"
                           Background="#0F161D"
                           BorderBrush="#243742"
                           Foreground="#EAF0F4" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Memory">
          <local:MemoryTabView />
        </TabItem>

        <TabItem Header="Notes">
          <ScrollViewer>
            <StackPanel Spacing="12" Margin="6">
              <Border Background="#132028" CornerRadius="16" Padding="18">
                <StackPanel Spacing="8">
                  <TextBlock Text="Important Constraint" FontSize="19" FontWeight="Bold" Foreground="#EAF0F4" />
                  <TextBlock Text="The Avalonia desktop host does not replace the in-game ImGui overlay. If ImGui is causing client crashes, that is a separate engine-side stabilization track."
                             TextWrapping="Wrap"
                             Foreground="#9AA8B3" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Column="1"
                    Width="12"
                    ResizeDirection="Columns"
                    Background="Transparent" />

      <StackPanel Grid.Column="2" Spacing="12" Margin="14,0,0,0">
        <Border Background="#132028" CornerRadius="16" Padding="18">
          <StackPanel Spacing="8">
            <TextBlock Text="Session State" FontSize="16" FontWeight="SemiBold" Foreground="#26C1A6" />
            <TextBlock Text="AC Status" Foreground="#9AA8B3" />
            <TextBlock x:Name="AcStatusText"
                       Text="No running AC clients detected."
                       Foreground="#EAF0F4"
                       TextWrapping="Wrap" />
            <TextBlock Text="Launch Profile" Foreground="#9AA8B3" Margin="0,4,0,0" />
            <TextBlock x:Name="LaunchProfileStatusText"
                       Text="Choose a server and account profile to preview the launch pair."
                       Foreground="#EAF0F4"
                       TextWrapping="Wrap" />
            <TextBlock Text="Live Sessions" Foreground="#9AA8B3" Margin="0,4,0,0" />
            <ListBox x:Name="SessionList"
                     MinHeight="140"
                     MaxHeight="260"
                     Background="#0F161D"
                     BorderBrush="#243742"
                     Foreground="#EAF0F4" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
