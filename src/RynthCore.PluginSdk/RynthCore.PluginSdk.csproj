<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>RynthCore.PluginSdk</PackageId>
    <Version>0.2.0</Version>
    <Authors>RynthCore</Authors>
    <Company>RynthCore</Company>
    <Description>Managed plugin SDK for RynthCore's native plugin ABI with validated helper and action surfaces.</Description>
    <PackageTags>rynthcore;plugin;sdk;asherons-call</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://example.invalid/RynthCore</RepositoryUrl>
    <RootNamespace>RynthCore.PluginSdk</RootNamespace>
    <AssemblyName>RynthCore.PluginSdk</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine's API version, compiled in so RynthCoreHost.CurrentApiVersion can't drift from it. -->
    <Compile Include="..\RynthCore.Engine\Plugins\PluginContractVersion.cs" Link="Shared\PluginContractVersion.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plugin manifests: generated from the plugin's csproj and embedded in its DLL (see the file).
         Packed as build\RynthCore.PluginSdk.targets so a PackageReference imports it by itself; with
         a ProjectReference, Directory.Build.targets imports it (RynthSuite\Plugins does). -->
    <None Include="build\RynthCore.PluginSdk.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

</Project>
